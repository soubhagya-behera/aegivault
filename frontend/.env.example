# Frontend environment — EXAMPLE ONLY. Copy to `.env` for local development.
# Do NOT commit real credentials or secrets. Vite only exposes variables
# prefixed with VITE_ to client code, so keep anything sensitive server-side.

# Base URL the client uses for API calls. The Vite dev server proxies this
# path to the backend (see vite.config.ts). `/api` is the documented default.
VITE_API_BASE_URL=/api

# Backend target used ONLY by the Vite dev server proxy (server-side, never
# bundled into client code). Change if your backend runs on another port.
AEGIVAULT_BACKEND_TARGET=http://localhost:8080
